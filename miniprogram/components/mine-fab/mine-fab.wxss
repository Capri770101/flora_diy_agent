/* 全局「我的」悬浮按钮：固定右下角，蓝白渐变 + 终末地切角 */
.fab {
  position: fixed;
  right: 28rpx;
  z-index: 900;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2B6CFF 0%, #16C2D5 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 8rpx 22rpx rgba(43, 108, 255, 0.40);
  /* 右上 + 左下切角，呼应透明三角形卡片风格 */
  clip-path: polygon(22% 0, 100% 0, 100% 78%, 78% 100%, 0 100%, 0 22%);
}
.fab-hover { opacity: 0.85; }
.fab-ico { font-size: 34rpx; line-height: 1; }
.fab-txt {
  font-size: 20rpx;
  color: #fff;
  margin-top: 4rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
