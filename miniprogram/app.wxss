page { background: #fafafa; font-family: "PingFang SC", sans-serif; }
.btn { background: #8E44AD; color: #fff; border-radius: 24rpx; }
.tag { display: inline-block; background: #F3E8FA; color: #8E44AD; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin: 4rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin: 20rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05); }
.dot { display: inline-block; width: 36rpx; height: 36rpx; border-radius: 50%; margin: 4rpx; border: 1rpx solid rgba(0,0,0,0.08); vertical-align: middle; }
