.orders { padding: 20rpx; }
/* .card 由 app.wxss 统一定义（透明三角形卡片） */
.head { display: flex; justify-content: space-between; align-items: center; }
.shop { font-size: 30rpx; font-weight: 600; color: #16233F; }
.status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 6rpx; }
.status.paid, .status.making, .status.delivering { background: #FFF4E2; color: #E58B1A; }
.status.done { background: #E8F6EC; color: #2E8B57; }
.status.created { background: #E8F1FF; color: #2B6CFF; }
.status.canceled { background: #EEF1F6; color: #9AA8C4; }
.sum { font-size: 26rpx; color: #44506B; line-height: 1.5; margin-top: 10rpx; }
.meta { font-size: 24rpx; color: #9AA8C4; margin-top: 8rpx; }
.foot { margin-top: 12rpx; display: flex; justify-content: flex-end; }
.link { font-size: 26rpx; color: #2B6CFF; }
.refresh { text-align: center; color: #2B6CFF; font-size: 26rpx; padding: 20rpx; }
.empty { text-align: center; color: #9AA8C4; margin-top: 100rpx; }
