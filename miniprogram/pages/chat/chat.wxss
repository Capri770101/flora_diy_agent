.chat { display: flex; flex-direction: column; height: 100vh; }
.msg-area { flex: 1; padding: 20rpx; }
.bubble { max-width: 82%; padding: 16rpx 22rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.5; margin-bottom: 16rpx; word-break: break-word; }
.bubble.user { background: #8E44AD; color: #fff; margin-left: auto; border-bottom-right-radius: 6rpx; }
.bubble.bot { background: #fff; border: 1rpx solid #eee; border-bottom-left-radius: 6rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin: 8rpx 0 20rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05); }
.card-title { font-size: 30rpx; font-weight: 700; color: #333; }
.warn { font-size: 22rpx; color: #e08e0b; background: #fff3e0; padding: 2rpx 10rpx; border-radius: 8rpx; margin-left: 10rpx; }
.dots { margin: 12rpx 0; }
.summary { font-size: 28rpx; color: #444; line-height: 1.6; }
.price { font-size: 32rpx; font-weight: 700; color: #d2691e; margin: 14rpx 0; }
.muted { font-weight: 400; color: #999; font-size: 24rpx; }
.label { font-size: 24rpx; color: #888; margin: 16rpx 0 8rpx; }
.flower-list { display: flex; flex-wrap: wrap; }
.pill { font-size: 24rpx; background: #f7f7f7; padding: 6rpx 16rpx; border-radius: 10rpx; border: 1rpx solid #eee; margin: 0 10rpx 10rpx 0; }
.step { font-size: 26rpx; color: #555; line-height: 1.8; }
.detail-btn { margin-top: 16rpx; text-align: center; color: #8E44AD; font-size: 26rpx; }
.input-bar { display: flex; padding: 16rpx; background: #fff; border-top: 1rpx solid #eee; }
.input { flex: 1; border: 1rpx solid #ddd; border-radius: 36rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; background: #8E44AD; color: #fff; padding: 0 32rpx; border-radius: 36rpx; font-size: 28rpx; display: flex; align-items: center; }
