/* chat 页面样式：蓝白 + 透明三角卡（真元素版） */
.chat { display: flex; flex-direction: column; height: 100vh; }
.msg-area { flex: 1; padding: 20rpx; }

.bubble {
  max-width: 82%; padding: 16rpx 22rpx; border-radius: 12rpx;
  font-size: 28rpx; line-height: 1.5; margin-bottom: 16rpx;
  word-break: break-word;
}
.bubble.user {
  background: linear-gradient(135deg, #2B6CFF, #16C2D5);
  color: #fff; margin-left: auto; border-bottom-right-radius: 4rpx;
  box-shadow: 0 6rpx 18rpx rgba(43,108,255,0.30);
}
.bubble.bot {
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.85) calc(50% - 1rpx),
      rgba(22,194,213,0.85) 50%,
      transparent 50%) top right / 24rpx 24rpx no-repeat,
    rgba(255,255,255,0.92);
  border: 1rpx solid rgba(43,108,255,0.30);
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(43,108,255,0.10);
}
.caret { color: #2B6CFF; font-weight: 700; animation: blink 0.9s infinite; }
@keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

/* 思考气泡 */
.thinking-bubble { display: flex; align-items: center; }
.thinking-dots { display: flex; align-items: center; margin-right: 14rpx; }
.t-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #2B6CFF; margin-right: 8rpx;
  animation: tpop 1s infinite ease-in-out;
}
.t-dot:nth-child(2) { animation-delay: 0.15s; }
.t-dot:nth-child(3) { animation-delay: 0.3s; margin-right: 0; }
@keyframes tpop { 0%, 100% { transform: translateY(0); opacity: 0.4; } 50% { transform: translateY(-8rpx); opacity: 1; } }
.thinking-text { font-size: 26rpx; color: #6B7A99; }

/* 方案入口：左侧蓝青竖条（真实元素）+ 透明三角卡 */
.plan-entry {
  display: flex; align-items: center;
  position: relative;
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.95) calc(50% - 1rpx),
      rgba(22,194,213,0.95) 50%,
      transparent 50%) top right / 32rpx 32rpx no-repeat,
    linear-gradient(90deg,
      transparent 0%,
      rgba(43,108,255,0.85) 25%,
      rgba(22,194,213,0.85) 70%,
      transparent 100%) top left / 100% 2rpx no-repeat,
    rgba(255,255,255,0.90);
  border: 1rpx solid rgba(43,108,255,0.30);
  border-radius: 0;
  padding: 20rpx 24rpx 20rpx 32rpx;
  margin: 8rpx 0 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(43,108,255,0.10);
  overflow: hidden;
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}
.pe-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #2B6CFF 0%, #16C2D5 100%);
  box-shadow: 0 0 8rpx rgba(43,108,255,0.5);
}
.plan-entry:active { background: #EAF1FF; }
.pe-title { font-size: 26rpx; font-weight: 700; color: #16233F; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.pe-brief { flex: 1; min-width: 0; margin-left: 20rpx; }
.pe-summary { font-size: 24rpx; color: #6B7A99; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.pe-price { font-size: 26rpx; font-weight: 700; color: #2B6CFF; }
.pe-arrow { font-size: 26rpx; color: #2B6CFF; padding-left: 12rpx; }
.warn { font-size: 20rpx; color: #E58B1A; background: #FFF4E2; padding: 2rpx 8rpx; border-radius: 8rpx; margin-left: 8rpx; }
.muted { font-weight: 400; color: #9AA8C4; font-size: 22rpx; }

/* 方案抽屉 */
.drawer-mask { position: fixed; inset: 0; background: rgba(6,19,51,0.55); z-index: 90; }
.plan-drawer {
  position: fixed; left: 0; right: 0; bottom: 0; width: 100%; box-sizing: border-box;
  background: linear-gradient(180deg, #EAF2FF 0%, #FFFFFF 18%, #FFFFFF 100%);
  border-radius: 28rpx 28rpx 0 0;
  z-index: 99; max-height: 75vh; display: flex; flex-direction: column;
  transform: translateY(105%); transition: transform 0.28s ease;
  box-shadow: 0 -10rpx 32rpx rgba(15,30,77,0.25);
  overflow: hidden;
}
.plan-drawer.show { transform: translateY(0); }
.drawer-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #E6EEFB;
  background: linear-gradient(90deg, rgba(43,108,255,0.04), rgba(22,194,213,0.06));
  flex-shrink: 0;
}
.drawer-title { font-size: 30rpx; font-weight: 700; color: #16233F; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
.drawer-close {
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #EAF1FF, #D6E5FF);
  color: #2B6CFF; font-size: 28rpx; margin-left: 16rpx; flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(43,108,255,0.20);
}
.drawer-body { padding: 8rpx 28rpx 40rpx; max-height: 60vh; box-sizing: border-box; width: 100%; }
.render-img { width: 100%; height: 420rpx; border-radius: 12rpx; margin: 16rpx 0 4rpx; background: linear-gradient(135deg, #E8F1FF, #EAF6FA); }
.dots { margin: 12rpx 0; }
.summary { font-size: 28rpx; color: #16233F; line-height: 1.6; word-break: break-all; overflow-wrap: break-word; }
.price { font-size: 32rpx; font-weight: 700; color: #2B6CFF; margin: 14rpx 0; text-shadow: 0 1rpx 2rpx rgba(43,108,255,0.15); }
.label { font-size: 24rpx; color: #6B7A99; margin: 16rpx 0 8rpx; }
.flower-list { display: flex; flex-wrap: wrap; }
.pill {
  font-size: 24rpx; background: linear-gradient(135deg, #EAF1FF, #DDF1F4);
  padding: 6rpx 16rpx; border-radius: 6rpx;
  border: 1rpx solid rgba(43,108,255,0.20);
  color: #1746B0; margin: 0 10rpx 10rpx 0;
  max-width: 100%; word-break: break-all; overflow-wrap: break-word;
  box-sizing: border-box;
}
.step { font-size: 26rpx; color: #44506B; line-height: 1.7; margin-bottom: 12rpx; word-break: break-all; overflow-wrap: break-word; }
.step-t { font-weight: 600; color: #16233F; }
.step-d { font-size: 24rpx; color: #6B7A99; margin-top: 4rpx; line-height: 1.6; word-break: break-all; overflow-wrap: break-word; }
.detail-btn { margin-top: 16rpx; text-align: center; color: #2B6CFF; font-size: 26rpx; }
.shops { margin-top: 20rpx; }
.shops-title { font-size: 26rpx; color: #44506B; margin-bottom: 12rpx; word-break: break-all; overflow-wrap: break-word; }

/* 抽屉里的门店卡：透明三角卡 */
.shop {
  position: relative; overflow: hidden;
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.85) calc(50% - 1rpx),
      rgba(22,194,213,0.85) 50%,
      transparent 50%) top right / 28rpx 28rpx no-repeat,
    rgba(255,255,255,0.88);
  border: 1rpx solid rgba(43,108,255,0.30);
  border-radius: 0;
  padding: 16rpx 18rpx; margin-bottom: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(43,108,255,0.08);
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}
.shop.picked {
  border: 2rpx solid #2B6CFF;
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(43,108,255,0.95) calc(50% - 1rpx),
      rgba(43,108,255,0.95) 50%,
      transparent 50%) top right / 28rpx 28rpx no-repeat,
    rgba(234,241,255,0.95);
}
.s-head { display: flex; align-items: center; min-width: 0; }
.s-name { font-size: 28rpx; font-weight: 600; color: #16233F; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 16rpx; box-sizing: border-box; }
.s-price { font-size: 28rpx; font-weight: 700; color: #2B6CFF; margin-left: auto; flex-shrink: 0; }
.s-meta { font-size: 22rpx; color: #6B7A99; margin-top: 6rpx; word-break: break-all; overflow-wrap: break-word; }
.s-miss { color: #E58B1A; }
.s-check { position: absolute; right: 16rpx; top: 14rpx; font-size: 24rpx; color: #2B6CFF; font-weight: 600; }
.more-shop { text-align: center; color: #2B6CFF; font-size: 26rpx; padding: 12rpx 0; }
.picked-bar {
  margin-top: 16rpx;
  background: linear-gradient(90deg, #2B6CFF, #16C2D5);
  color: #fff; text-align: center;
  border-radius: 40rpx;
  padding: 18rpx 0; font-size: 28rpx;
  word-break: break-all; overflow-wrap: break-word;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(43,108,255,0.30);
}

/* 输入栏 */
.input-bar {
  display: flex; padding: 16rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1rpx solid #E6EEFB;
  backdrop-filter: blur(8rpx);
}
.input {
  flex: 1;
  border: 1rpx solid rgba(43,108,255,0.30);
  border-radius: 36rpx;
  padding: 16rpx 24rpx; font-size: 28rpx;
  background: #fff;
  box-shadow: inset 0 1rpx 3rpx rgba(43,108,255,0.05);
}
.send-btn {
  margin-left: 16rpx;
  background: linear-gradient(90deg, #2B6CFF, #16C2D5);
  color: #fff; padding: 0 32rpx;
  border-radius: 36rpx; font-size: 28rpx;
  display: flex; align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(43,108,255,0.30);
}
