<view class="home">
  <view class="hero">
    <view class="hero-title">🌸 花艺顾问</view>
    <view class="hero-sub">说一句需求，智能体帮你设计专属花艺方案与效果图</view>
  </view>

  <view class="section-title">
    <view class="section-bar"></view>
    <text>快速开始</text>
  </view>
  <view class="scene-grid">
    <view class="scene" wx:for="{{scenes}}" wx:key="label" bindtap="goChat" data-q="{{item.q}}">
      <view class="scene-icon">{{item.icon}}</view>
      <view class="scene-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section-title">
    <view class="section-bar"></view>
    <text>或自由描述</text>
  </view>
  <view class="free-btn btn" bindtap="goChat" data-q="">开始对话 →</view>

  <!-- ⑤ 历史方案入口（服务端持久化，跨设备） -->
  <view class="section-title">
    <view class="section-bar"></view>
    <text>历史方案</text>
  </view>
  <view wx:if="{{plans.length === 0}}" class="hist-empty">还没有历史方案，先去对话生成一份吧～</view>
  <view class="hist-list">
    <view class="hist-item" wx:for="{{plans}}" wx:key="plan_id" bindtap="goPlan" data-id="{{item.plan_id}}">
      <image wx:if="{{item.render_url}}" class="hist-img" src="{{item.render_url}}" mode="aspectFill" />
      <view class="hist-body">
        <view class="hist-summary">{{item.summary}}</view>
        <view class="hist-meta">
          <text class="hist-price">约 ¥{{item.total}}</text>
          <text wx:if="{{item.budget}}" class="muted"> / 预算 ¥{{item.budget}}</text>
          <text class="hist-mode {{item.mode === 'existing' ? 'is-existing' : 'is-diy'}}">{{item.mode === 'existing' ? '现有方案' : 'DIY'}}</text>
        </view>
        <view class="hist-date">{{item.created_at}}</view>
      </view>
    <view class="hist-arrow">›</view>
  </view>
</view>
<!-- 全局「我的」悬浮按钮 -->
<mine-fab fab-pos="fab-d" />
</view>
