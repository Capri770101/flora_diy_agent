/* home 页面：蓝白 + 透明三角卡 */
/* 横向 padding 归零，块级卡片统一由自身 margin(28rpx) 控制左对齐 */
.home { padding: 0 0 24rpx; }

/* 顶部主视觉：深蓝 HUD + 斜切（终末地感） */
.hero {
  position: relative;
  background:
    radial-gradient(ellipse at top right, rgba(22,194,213,0.30) 0%, transparent 60%),
    linear-gradient(135deg, #061333 0%, #0F1E4D 35%, #16337A 65%, #2B6CFF 100%);
  border-radius: 0;
  padding: 70rpx 32rpx 90rpx;
  color: #fff;
  margin-bottom: 8rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(6,19,51,0.35);
  /* 底部斜切 */
  clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
}
.hero-title {
  font-size: 48rpx; font-weight: 800; letter-spacing: 2rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.40);
  display: block;
}
.hero-sub {
  display: block;
  font-size: 26rpx; opacity: 0.92; margin-top: 16rpx; line-height: 1.6;
  color: rgba(255,255,255,0.92);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.25);
}

/* .section-title 用全局（带蓝青竖条） */
.section-title { font-size: 28rpx; }

/* 场景网格：左右 margin 28rpx，与 .section-title / .card / .btn 左对齐
   兼容写法：纯百分比宽度 + space-between，不依赖 calc / gap（部分手机微信对二者支持不稳） */
.scene-grid {
  display: flex; flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 28rpx 8rpx;
  padding: 0;
}

/* 场景卡：透明三角卡（用 background-image 多重渐变实现装饰，无伪元素） */
.scene {
  width: 48%;
  margin-bottom: 16rpx;
  position: relative;
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.90) calc(50% - 1rpx),
      rgba(22,194,213,0.90) 50%,
      transparent 50%) top right / 28rpx 28rpx no-repeat,
    linear-gradient(90deg,
      transparent 0%,
      rgba(43,108,255,0.80) 25%,
      rgba(22,194,213,0.80) 70%,
      transparent 100%) top left / 100% 2rpx no-repeat,
    rgba(255,255,255,0.92);
  border: 1rpx solid rgba(43,108,255,0.30);
  border-radius: 0;
  padding: 28rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(43,108,255,0.10);
  overflow: hidden;
  box-sizing: border-box;
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
  transition: transform 0.15s ease;
}
.scene:active {
  transform: scale(0.97);
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.95) calc(50% - 1rpx),
      rgba(22,194,213,0.95) 50%,
      transparent 50%) top right / 28rpx 28rpx no-repeat,
    rgba(234,241,255,0.95);
}
.scene-icon {
  font-size: 52rpx;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.10);
}
.scene-label {
  font-size: 28rpx; margin-top: 12rpx;
  color: #16233F; font-weight: 600;
  display: block;
}

/* 主按钮（用 .btn 全局类，clip-path + 蓝青渐变） */
.free-btn {
  display: block; text-align: center;
  padding: 26rpx 0; font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 全局「我的」悬浮按钮定位（右下角，避开安全区） */
.fab-d { bottom: calc(32rpx + env(safe-area-inset-bottom)); }
