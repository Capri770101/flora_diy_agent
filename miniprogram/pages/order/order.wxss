.order { padding: 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05); }
.label { font-size: 26rpx; color: #888; margin-bottom: 12rpx; }
.plan-sum { font-size: 28rpx; color: #333; line-height: 1.6; margin-bottom: 8rpx; }
.shop-name { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 6rpx; }
.price { font-size: 34rpx; font-weight: 700; color: #d2691e; margin-top: 12rpx; }
.muted { font-size: 24rpx; color: #999; font-weight: 400; }
.warn { color: #e74c3c; font-size: 24rpx; }
.radio { margin-right: 40rpx; font-size: 28rpx; color: #333; }
.input { background: #f7f7f7; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; margin-top: 16rpx; }
.flower { display: flex; justify-content: space-between; font-size: 26rpx; color: #555; padding: 8rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.flower:last-child { border-bottom: none; }
.meta { color: #d2691e; font-weight: 600; }
.btn { background: #8E44AD; color: #fff; text-align: center; border-radius: 44rpx; padding: 22rpx 0; font-size: 30rpx; font-weight: 600; margin-top: 10rpx; }
.btn.pay { background: #d2691e; }
.btn.done { background: #7a8f7a; }
