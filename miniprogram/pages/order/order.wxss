.order { padding: 0 0 20rpx; }
/* .card 由 app.wxss 统一定义（透明三角形卡片） */
.label { font-size: 26rpx; color: #6B7A99; margin-bottom: 12rpx; }
.plan-sum { font-size: 28rpx; color: #16233F; line-height: 1.6; margin-bottom: 8rpx; }
.shop-name { font-size: 30rpx; font-weight: 600; color: #16233F; margin-bottom: 6rpx; }
.price { font-size: 34rpx; font-weight: 700; color: #2B6CFF; margin-top: 12rpx; }
.muted { font-size: 24rpx; color: #9AA8C4; font-weight: 400; }
.warn { color: #E58B1A; font-size: 24rpx; }
.radio { margin-right: 40rpx; font-size: 28rpx; color: #16233F; }
.input { background: #F2F6FE; border: 1rpx solid #D5E2FA; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; margin-top: 16rpx; }
.flower { display: flex; justify-content: space-between; font-size: 26rpx; color: #44506B; padding: 8rpx 0; border-bottom: 1rpx solid #EEF3FB; }
.flower:last-child { border-bottom: none; }
.meta { color: #2B6CFF; font-weight: 600; }
/* .btn / .btn.pay / .btn.done 由 app.wxss 统一定义（科技蓝渐变） */
