/* plan 页面：蓝白 + 透明三角卡 */
/* 横向 padding 归零，hero 通栏 + .card 统一 margin(28rpx) 控制左对齐 */
.plan { padding: 0 0 20rpx; }

/* 顶部主视觉：深蓝渐变，无阴影、无斜切，与下方页面背景连续（修复色块分界）
   原设计：底部斜切 polygon(0 0, 100% 0, 100% 86%, 0 100%) + box-shadow，会在斜切处暴露页面背景，
   且硬阴影在 hero 下方形成可见暗带，产生"色块分界"。本版改为垂直渐变收尾于 #2B6CFF，
   与 page 全局渐变在 hero 底部位置同色系，margin-bottom:0 直接衔接页面背景。 */
.hero {
  position: relative;
  background: linear-gradient(180deg, #061333 0%, #0F1E4D 30%, #16337A 60%, #2B6CFF 100%);
  border-radius: 0;
  padding: 60rpx 32rpx 70rpx;
  color: #fff;
  margin-bottom: 0;
  overflow: hidden;
}
/* hero 装饰用 background-image 多重渐变，不用伪元素 */
/* .hero 装饰已通过 background: radial-gradient + linear-gradient 实现 */
.h-title {
  font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.35);
  display: block;
}
.h-sub {
  font-size: 26rpx; opacity: 0.92; margin-top: 12rpx; line-height: 1.5;
  color: rgba(255,255,255,0.92);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.25);
  display: block;
}

/* .card 由 app.wxss 统一定义 */
.label { font-size: 26rpx; color: #6B7A99; margin-bottom: 12rpx; }
.dots { margin: 8rpx 0; }
.price { font-size: 36rpx; font-weight: 700; color: #2B6CFF; margin: 10rpx 0; text-shadow: 0 1rpx 2rpx rgba(43,108,255,0.15); }
.muted { font-weight: 400; color: #9AA8C4; font-size: 24rpx; }
.pkg { font-size: 26rpx; color: #44506B; }

.flower { padding: 14rpx 0; border-bottom: 1rpx solid rgba(43,108,255,0.10); }
.flower:last-child { border-bottom: none; }
.flower-head { display: flex; align-items: center; }
.dot { display: inline-block; width: 28rpx; height: 28rpx; border-radius: 50%; }
.dot.sm { width: 28rpx; height: 28rpx; }
.flower .name { font-size: 28rpx; color: #16233F; margin-left: 12rpx; }
.flower .role {
  font-size: 20rpx; color: #1746B0;
  background: rgba(43,108,255,0.10);
  padding: 2rpx 12rpx; border-radius: 6rpx;
  margin-left: 12rpx;
  border: 1rpx solid rgba(43,108,255,0.25);
}
.flower .meta { font-size: 24rpx; color: #2B6CFF; font-weight: 600; margin-left: auto; }
.flower-meta { font-size: 22rpx; color: #9AA8C4; margin-top: 6rpx; }
.flower-care { font-size: 22rpx; color: #3E7CC4; margin-top: 4rpx; line-height: 1.6; }

.step { font-size: 26rpx; color: #44506B; line-height: 1.6; padding: 10rpx 0; }
.num {
  display: inline-block; width: 36rpx; height: 36rpx;
  line-height: 36rpx; text-align: center;
  background: linear-gradient(135deg, #2B6CFF, #16C2D5);
  color: #fff; border-radius: 8rpx;
  font-size: 22rpx; margin-right: 12rpx;
  box-shadow: 0 3rpx 8rpx rgba(43,108,255,0.25);
}
.step-t { font-size: 28rpx; color: #16233F; font-weight: 600; }
.step-d { font-size: 24rpx; color: #6B7A99; margin: 6rpx 0 0 48rpx; line-height: 1.6; }
.care { font-size: 24rpx; color: #44506B; line-height: 1.7; padding: 6rpx 0; }

/* 门店卡：透明三角卡（用 background-image 多重渐变实现装饰，无伪元素） */
.shop {
  position: relative; overflow: hidden;
  background:
    linear-gradient(45deg,
      transparent calc(50% - 1rpx),
      rgba(22,194,213,0.85) calc(50% - 1rpx),
      rgba(22,194,213,0.85) 50%,
      transparent 50%) top right / 28rpx 28rpx no-repeat,
    linear-gradient(90deg,
      transparent 0%,
      rgba(43,108,255,0.80) 25%,
      rgba(22,194,213,0.80) 70%,
      transparent 100%) top left / 100% 2rpx no-repeat,
    rgba(255,255,255,0.90);
  border: 1rpx solid rgba(43,108,255,0.30);
  border-radius: 0;
  padding: 20rpx; margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(43,108,255,0.10);
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}
.shop:last-child { margin-bottom: 0; }
.shop-head { display: flex; align-items: center; }
.shop-name { font-size: 30rpx; font-weight: 600; color: #16233F; }
.shop-dist { font-size: 24rpx; color: #6B7A99; margin-left: auto; }
.shop-meta { font-size: 24rpx; color: #6B7A99; margin-top: 8rpx; }
.shop-price { font-size: 32rpx; font-weight: 700; color: #2B6CFF; margin-top: 8rpx; text-shadow: 0 1rpx 2rpx rgba(43,108,255,0.15); }
.order-btn {
  margin-top: 16rpx;
  background: linear-gradient(90deg, #2B6CFF, #16C2D5);
  color: #fff; text-align: center;
  border-radius: 40rpx;
  padding: 16rpx 0; font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(43,108,255,0.30);
}
.warn { color: #E58B1A; }
.empty { text-align: center; color: #9AA8C4; margin-top: 100rpx; }
