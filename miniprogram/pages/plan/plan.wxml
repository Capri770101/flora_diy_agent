<view class="page-bg"></view>
<view class="plan" wx:if="{{plan}}">
  <view class="hero">
    <view class="h-title">🌿 你的专属花艺方案</view>
    <view class="h-sub">{{plan.summary}}</view>
  </view>

  <view class="card">
    <view class="label">配色预览</view>
    <view class="dots">
      <view class="dot" wx:for="{{plan.items}}" wx:key="flower_id" style="background:{{item.color}}"></view>
    </view>
    <view class="price">约 ¥{{plan.total}}<text wx:if="{{plan.budget}}" class="muted"> / 预算 ¥{{plan.budget}}</text></view>
    <view class="pkg">包装：{{plan.package}}</view>
  </view>

  <view class="card">
    <view class="label">花材清单 · 花语与寓意</view>
    <view class="flower" wx:for="{{plan.items}}" wx:key="flower_id">
      <view class="flower-head">
        <view class="dot sm" style="background:{{item.color}}"></view>
        <text class="name">{{item.name}} ×{{item.qty}}{{item.unit}}</text>
        <text class="role">{{item.role}}</text>
        <text class="meta">¥{{item.price * item.qty}}</text>
      </view>
      <view class="flower-meta">花语：{{item['花语']}} · 花期：{{item['花期']}} · 时令：{{item.season || '全年'}}</view>
      <view class="flower-care">💧 {{item.care}}</view>
    </view>
  </view>

  <view class="card">
    <view class="label">门店执行工单（{{plan.structure}}）</view>
    <view class="step" wx:for="{{plan.steps}}" wx:key="index">
      <text class="num">{{index+1}}</text>
      <text class="step-t">{{item.t}}</text>
      <view class="step-d">{{item.d}}</view>
    </view>
  </view>

  <view class="card">
    <view class="label">💧 日常养护建议</view>
    <view class="care" wx:for="{{plan.care_tips}}" wx:key="index">· {{item}}</view>
  </view>

  <!-- 改进②：方案卡不含店铺选择；选店是下方独立区块，与方案卡分离 -->
  <view class="card">
    <view class="label">🏪 选择花店（独立选店，方案不含店铺）</view>
    <view wx:if="{{loadingShops}}" class="care">正在匹配附近花店…</view>
    <block wx:elif="{{shops.length}}">
      <view class="shop-item {{selectedShop && selectedShop.shop_id === s.shop_id ? 'picked' : ''}}"
            wx:for="{{shops}}" wx:key="shop_id" wx:for-item="s"
            bindtap="onPickShop" data-shop-id="{{s.shop_id}}">
        <view class="shop-name">{{s.name}}</view>
        <view class="shop-meta">{{s.district}} · ⭐{{s.rating}}<text wx:if="{{s.distance_km != null}}"> · {{s.distance_km}}km</text></view>
        <view class="shop-price">¥{{s.price_total}}<text class="muted" wx:if="{{s.price_diff}}">（vs 方案 {{s.price_diff > 0 ? '+' : ''}}{{s.price_diff}}）</text></view>
      </view>
    </block>
    <view wx:else class="care">暂无可匹配花店，可回对话重新选店</view>
    <view class="btn pay" wx:if="{{selectedShop}}" bindtap="goOrder">选「{{selectedShop.name}}」· 去下单 →</view>
    <view class="care" wx:if="{{!selectedShop}}">选一家花店后即可下单</view>
  </view>

  <!-- 备选入口：回到对话，由独立选店卡片完成 -->
  <view class="btn order-btn" bindtap="goChat">回对话继续沟通 →</view>
  <!-- 全局「我的」悬浮按钮 -->
  <mine-fab fab-pos="fab-d" />
</view>
<view wx:else class="empty">方案不存在</view>
